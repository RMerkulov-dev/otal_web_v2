---
/**
 * Поява тексту секцій під час прокручування.
 * Заголовки виїжджають по словах з-під маски, решта блоків м'яко проявляється по черзі.
 * Живі секції (data-art-host) отримують [data-art-live], поки вони на екрані: від цього
 * залежать їхні анімації в global.css і табло лабораторії.
 * Кожен елемент тексту анімується один раз. Ховаємо лише те, що скрипт сам позначив data-reveal,
 * тож без JavaScript і з prefers-reduced-motion усе видно одразу.
 */
---

<script>
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Групи: елементи всередині однієї групи з'являються по черзі. */
  const groups = [
    '.section-head',
    '.about__grid',
    '.facts',
    '.works__grid',
    '.works__footer',
    '.laboratory__body',
    '.reasons',
    '.steps',
    '.contacts__info',
    '.contacts__list',
  ];

  const blocks = [
    '.section-head > :not(.heading)',
    '.about__grid > :not(.heading)',
    '.facts__cell',
    '.work-group',
    '.works__footer > *',
    '.laboratory__body > :not(.heading, .reasons)',
    '.reasons > li',
    '.laboratory__figure',
    '.step',
    '.contacts__info > :not(.heading, .contacts__list)',
    '.contacts__list > div',
    '.request',
  ];

  if (!still && 'IntersectionObserver' in window) {
    /* Заголовок ділимо на слова: кожне — у власній «щілині», з якої воно виїжджає. */
    document.querySelectorAll<HTMLElement>('main .heading').forEach((heading) => {
      const words = (heading.textContent ?? '').trim().split(/\s+/);
      heading.setAttribute('aria-label', words.join(' '));
      heading.textContent = '';
      words.forEach((word, i) => {
        const slot = document.createElement('span');
        slot.className = 'reveal-word';
        slot.setAttribute('aria-hidden', 'true');
        const inner = document.createElement('span');
        inner.textContent = word;
        inner.style.setProperty('--ri', String(i));
        slot.append(inner);
        heading.append(slot, i < words.length - 1 ? ' ' : '');
      });
      heading.dataset.reveal = 'words';
    });

    document.querySelectorAll<HTMLElement>(blocks.join(',')).forEach((el) => {
      const group = el.closest(groups.join(','));
      const siblings = group ? [...group.querySelectorAll('[data-reveal="block"]')] : [];
      el.dataset.reveal = 'block';
      el.style.setProperty('--ri', String(siblings.length));
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.setAttribute('data-shown', '');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.15 },
    );

    document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

    /* Фонові креслення секцій: прокреслюються, коли секція з'являється, і «живуть»,
       поки вона на екрані. Пішла з екрана — анімація зупиняється (і перемалюється наступного разу). */
    const hosts = document.querySelectorAll<HTMLElement>('[data-art-host]');
    const artObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target.toggleAttribute('data-art-live', entry.isIntersecting);
          if (entry.isIntersecting) entry.target.dispatchEvent(new Event('art:live'));
        });
      },
      { threshold: 0.2 },
    );
    hosts.forEach((host) => {
      host.setAttribute('data-art-armed', '');
      artObserver.observe(host);
    });

    /* Табло лабораторії: число «набігає» від нуля, далі ледь коливається, як живий прилад.
       Працює лише поки секція на екрані. */
    document.querySelectorAll<HTMLElement>('[data-readout]').forEach((el) => {
      const target = Number(el.dataset.readout);
      const host = el.closest<HTMLElement>('[data-art-host]');
      const format = (n: number) => Math.round(n).toLocaleString('uk-UA');
      let jitter = 0;
      host?.addEventListener('art:live', () => {
        const start = performance.now();
        const run = (now: number) => {
          const t = Math.min((now - start) / 1600, 1);
          el.textContent = format(target * (1 - (1 - t) ** 3));
          if (t < 1) requestAnimationFrame(run);
        };
        requestAnimationFrame(run);
        window.clearInterval(jitter);
        jitter = window.setInterval(() => {
          if (!host.hasAttribute('data-art-live')) return window.clearInterval(jitter);
          el.textContent = format(target + Math.round((Math.random() - 0.5) * 12));
        }, 1400);
      });
    });
  }
</script>
